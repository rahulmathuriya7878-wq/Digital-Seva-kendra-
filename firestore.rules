rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Token Bookings:
    // Allow public creation of booking tokens by citizens without authentication.
    // Allow reading by anyone with the token or within portal / admin.
    match /tokenBookings/{bookingId} {
      allow read, create: if true;
      allow update, delete: if true;
    }
  }
}
